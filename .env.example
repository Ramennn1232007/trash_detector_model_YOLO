# Copy to .env and fill in. Never commit .env.
MODEL_PATH=models/best_one_class.pt
CONF_THRESHOLD=0.25
TRASH_THRESHOLD=5
CAMERA_SOURCE=0
SHOW_WINDOW=true
EVENTS_FILE=detections.jsonl
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000

# Optional: protects POST endpoints
API_KEY=

# Optional: WhatsApp alerts (numbers must start with "whatsapp:+")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
RECIPIENT_NUMBER=

# Optional: S3 upload of detection events
S3_BUCKET=
